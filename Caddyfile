{
	servers {
		# an upstream TLS proxy on a private address: keep its X-Forwarded-* headers
		trusted_proxies static private_ranges
	}
}

:80 {
	# /hooks/*: inbound webhooks (Postmark, Cloudflare Email Worker); without
	# this they would fall through to the SPA and return 200 with index.html
	@edge path /api/* /hooks/* /healthz /readyz /version
	handle @edge {
		reverse_proxy server:8080
	}
	# presigned S3 on the public host (path-style /<bucket>/*); Host is passed
	# through unchanged because the signatures are host-bound
	@s3 path /{$S3_BUCKET}/*
	handle @s3 {
		reverse_proxy minio:9000
	}
	handle {
		# hashed build output never changes under the same name
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html, sw.js, manifest, icons, SPA routes must revalidate, or
		# old service workers and shells stick around
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"

		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"

		try_files {path} /index.html
		file_server
	}
}